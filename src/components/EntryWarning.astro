---
// A content warning shown before visitors enter the site.
// Change the words in the box below, or the address the LEAVE button goes to.
const leaveUrl = 'https://www.google.com';
---

<!-- A built-in browser "dialog" box: it is hidden until the script below opens it,
     and ENTER closes it for good. If anything ever goes wrong, the site stays usable. -->
<dialog id="entry-warning" aria-labelledby="entry-title">
  <div class="win98-window entry-box">
    <div class="win98-title">⚠️W A R N I N G⚠️</div>
    <div class="win98-content">
<h2 id="entry-title" class="glow-title red">Before you enter...</h2>
<hr class="glow-divider red" />
      <p>This website is full of HORROR!</p>
      <p><strong>Fake blood and gore imagery, disturbing themes, and flashing/flickering effects and lights.</strong></p>
      <p>This is your ONLY and FINAL warning.</p>
      <div class="entry-buttons">
        <button id="entry-enter" class="entry-button" type="button">ENTER</button>
        <a class="entry-button leave" href={leaveUrl} rel="noopener noreferrer">LEAVE</a>
      </div>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    var dialog = document.getElementById('entry-warning');
    var button = document.getElementById('entry-enter');
    if (!dialog || !button || typeof dialog.showModal !== 'function') return;

    // Visitors who already clicked ENTER during this visit don't see it again
    try {
      if (sessionStorage.getItem('entry-ok') === 'yes') return;
    } catch (e) {}

    button.addEventListener('click', function () {
      try { sessionStorage.setItem('entry-ok', 'yes'); } catch (e) {}
      dialog.close();
    });

    // Pressing Esc shouldn't skip the warning
    dialog.addEventListener('cancel', function (event) {
      event.preventDefault();
    });

    dialog.showModal();
  })();
</script>

<style is:global>
  #entry-warning {
    width: calc(100% - 40px);
    max-width: 520px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #d0e0d4;
    font-family: inherit;
  }
  #entry-warning::backdrop {
    background: rgba(0, 0, 0, 0.94);
  }
  .entry-box {
    margin: 0;
  }
  .entry-box p {
    margin: 0 0 12px 0;
  }
  .entry-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
  .entry-button {
    padding: 8px 22px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-decoration: none;
    color: #88ffaa;
    background: #051a09;
    border: 1px solid #00ff66;
    box-shadow: 2px 2px 0 #000000;
    cursor: pointer;
  }
  .entry-button:hover,
  .entry-button:focus-visible {
    background: #0d4a1b;
    color: #ffffff;
  }
  .entry-button.leave {
    color: #8a8a8a;
    border-color: #3a3a3a;
  }
</style>
