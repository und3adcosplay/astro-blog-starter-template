      { label: 'Tumbler', href: '#' },
      { label: 'Facebook', href: '#' },
    ],
    barTitle: '🍒🍎🌹',
    barColor: '#7a0f1a',
    barTextColor: '#ffffff',
    borderColor: '#a01020',
    photoBorderColor: '#ff4d5e',
    panelColor: '#14060a',
    textColor: '#ffffff',
    accentColor: '#ff4d5e',
    photoBorderColor: '#a01020',
