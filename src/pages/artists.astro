---
import SiteLayout from '../layouts/SiteLayout.astro';

// One block per artist. To add an artist, copy a whole block { ... } and paste it
// right after the last one (don't forget the comma at the end of each block).
//
// THE BASICS (every artist needs these)
//   username = the heading inside their panel
//   image    = a picture in the public folder (a roughly square one looks best)
//   intro    = their introduction; each line in the list becomes its own paragraph
//   links    = their socials: label = the button's words, href = the full web address
//              (use '#' until you have the link)
//
// OPTIONAL SETTINGS (leave a line out and that part keeps the normal look)
//   barTitle     = the words on the panel's top bar (use '' for no words at all).
//                  If you leave it out, the bar shows their username.
//   barColor     = color of the top bar
//   barTextColor = color of the words on the top bar
//   borderColor  = color of the panel's outline and the dashed line
//                  (also the picture's outline, unless photoBorderColor is set)
//   photoBorderColor = color of the outline around their picture
//   panelColor   = color of the panel's background
//   textColor    = color of the introduction text
//   accentColor  = color of their glowing username and their link buttons
//   (colors are codes in quotes, like '#c58bff')
//   font         = font for the panel's words (type its name exactly as it appears on
//                  fonts.google.com, like 'Special Elite')
//   titleFont    = font for their glowing username (same rule; the normal one is Creepster)
