    borderColor: '#8a8a8a',
    photoBorderColor: '#e6e6e6',
    panelColor: '#0b0b0b',
    textColor: '#e0e0e0',
    accentColor: '#ffffff',
    photoBorderColor: '#8a8a8a',
    font: 'Special Elite',
    titleFont: 'Butcherman',
  },
];

// Turns an artist's choices into settings for their panel.
// You don't need to change anything below this line.
const colorSettings = (artist) =>
  [
    artist.barColor && `--c-bar: ${artist.barColor}`,
    artist.barTextColor && `--c-bar-text: ${artist.barTextColor}`,
    artist.borderColor && `--c-border: ${artist.borderColor}`,
    artist.photoBorderColor && `--c-photo-border: ${artist.photoBorderColor}`,
    artist.panelColor && `--c-panel: ${artist.panelColor}`,
    artist.textColor && `--c-text: ${artist.textColor}`,
    artist.accentColor && `--c-accent: ${artist.accentColor}`,
    artist.font && `font-family: '${artist.font}', 'Courier New', monospace`,
  ]
    .filter(Boolean)
    .join('; ');

// The settings for the glowing username
const titleSettings = (artist) =>
  [
    artist.accentColor && `--glow-color: ${artist.accentColor}`,
    artist.titleFont && `font-family: '${artist.titleFont}', 'Creepster', sans-serif`,
  ]
    .filter(Boolean)
    .join('; ') || undefined;

// Loads each font the artists asked for, one at a time,
// so a typo in one font's name can't stop the others from loading
const fontNames = [
  ...new Set(artists.flatMap((artist) => [artist.font, artist.titleFont]).filter(Boolean)),
];
const fontLinks = fontNames.map(
  (name) => `https://fonts.googleapis.com/css2?family=${name.trim().replace(/\s+/g, '+')}&display=swap`,
);
---
<SiteLayout title="Artist Recs" description="Artists I recommend, with their socials." scrollCenter>
  {fontLinks.map((href) => <link rel="stylesheet" href={href} />)}

  <div class="win98-window">
    <div class="win98-title">🎨 ARTIST RECS</div>
    <div class="win98-content">
      <h1 class="glow-title">Artists I Recommend</h1>
      <hr class="glow-divider" />
      <p>These artists are my family, friends, and/or mutuals! Consider following and showing them support! 💚</p>
      <p>Everyome here is AI📵FREE and proudly human made!</p>
    </div>
  </div>

  {artists.length > 0 ? (
    artists.map((artist) => (
      <div class="win98-window artist-card" style={colorSettings(artist)}>
        <div class="win98-title">{artist.barTitle ?? `👤 ${artist.username}`}</div>
        <div class="win98-content artist-body">
          <div class="artist-photo">
            <img src={artist.image} alt={artist.username} onerror="this.style.display='none'" />
          </div>
          <div class="artist-info">
            <h2
              class="glow-title small"
              style={titleSettings(artist)}
            >
              {artist.username}
            </h2>
            <hr class="glow-divider" />
            {artist.intro.map((paragraph) => <p>{paragraph}</p>)}
            <div class="artist-links">
              {artist.links.map((link) => (
                <a
                  class="social-link"
                  href={link.href}
                  target={link.href === '#' ? undefined : '_blank'}
                  rel={link.href === '#' ? undefined : 'noopener noreferrer'}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))
  ) : (
    <div class="win98-window">
      <div class="win98-title">🎨 COMING SOON</div>
      <div class="win98-content">
        <p>Nobody here yet... check back soon.</p>
      </div>
    </div>
  )}
</SiteLayout>

<style is:global>
  /* This page has no right sidebar, so the middle column stretches across */
  #rightSidebar {
    display: none !important;
  }
  /* Keep the left menu at its normal width */
  @media (min-width: 851px) {
    #leftSidebar {
      flex: 0 0 196px !important;
    }
  }
</style>

<style>
  /* Each artist's panel. The colors come from that artist's own settings above,
     and fall back to the normal green look when they aren't set. */
  .artist-card {
    border-color: var(--c-border, #125a22);
    background-color: var(--c-panel, #020b04);
  }
  .artist-card .win98-title {
    background: var(--c-bar, #0d4a1b);
    color: var(--c-bar-text, #00ff66);
  }
  .artist-card .win98-content {
    color: var(--c-text, #d0e0d4);
  }
  .artist-card .glow-divider {
    border-top-color: var(--c-border, #0d4a1b);
  }

  /* Picture on the left, introduction on the right */
  .artist-body {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .artist-photo {
    position: relative;
    flex-shrink: 0;
    width: 190px;
    aspect-ratio: 1 / 1;
    background: #000000;
    border: 1px solid var(--c-photo-border, var(--c-border, #0d4a1b));
  }
  .artist-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .artist-info {
    flex: 1;
    min-width: 0;
  }
  .artist-info p {
    margin: 0 0 10px 0;
  }

  /* Their social links, as little buttons */
  .artist-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }
  .social-link {
    padding: 5px 14px;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    color: var(--c-accent, #88ffaa);
    background: #051a09;
    border: 1px solid var(--c-accent, #00ff66);
    box-shadow: 2px 2px 0 #000000;
  }
  .social-link:hover {
    background: var(--c-accent, #0d4a1b);
    color: var(--c-panel, #ffffff);
  }

  /* On phones, put the picture above the introduction */
  @media (max-width: 600px) {
    .artist-body {
      flex-direction: column;
    }
    .artist-photo {
      width: 100%;
      max-width: 260px;
    }
  }
</style>
