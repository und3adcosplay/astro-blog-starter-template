---
import SiteLayout from '../../layouts/SiteLayout.astro';

// One entry per franchise page. "theme" picks the look
// (colors, fonts and effects live in src/styles/themes.css).
export function getStaticPaths() {
  const fandoms = [
    { slug: 'silent-hill', name: 'Silent Hill', theme: 'silent-hill',
      gifs: [
        '/sh-eileen.gif',
        '/sh-valt.gif',
        '/sh-maria.gif',
        '/sh-rabbit.gif',
        '/sh-thegoat.gif',
        '/sh-rpt.gif',
        '/sh-heather.gif',
        '/sh-lisa.gif',
        '/sh-theroom.gif',
        '/sh-down.gif',
        '/sh-moa.gif',
        '/sh-james.gif',
      ],
       top: {
    title: 'QUICK FACTS',
    image: '/halo.png',
    alt: 'Halo of the Sun.',
    lines: ['Halo of the Sun.'],
  },
  long: {
    title: 'COSPLAYS',
    sections: [
      {
        heading: 'Cosplays',
        items: [
'📻Heather Mason📻',
'🩸Lisa Garland🩸',],
      },
      { heading: 'Cosplans', items: [
'🔥Alessa Gillespie🔥',
'🔪Angela Orosco🔪',
'🖍️Cheryl Mason🖍️',
'🚔Cybil Bennett🚔',
'👜Eileen Galvin👜',
'💋Maria💋',
'📃Mary Sunderland📃',
'🎠Memory of Alessa🎠',] },
      { heading: 'Returning', items: [] },
      { heading: 'Retired', items: [] },
    ],
  },
},
    { slug: 'resident-evil', name: 'Resident Evil', theme: 'resident-evil',
      gifs: [
        '/robbie-the-rabbit.gif',
 ],
       top: {
    title: 'QUICK FACTS',
    image: '/halo.png',
    alt: 'A short description of the picture',
    lines: ['The text under the picture'],
  },
  long: {
    title: 'COSPLAYS',
    items: ['First cosplay', 'Second cosplay', 'Third cosplay'],
  },
},
    { slug: 'creepypasta', name: 'Creepypasta', theme: 'creepypasta',
      gifs: [
        '/robbie-the-rabbit.gif',
 ],
       top: {
    title: 'QUICK FACTS',
    image: '/halo.png',
    alt: 'A short description of the picture',
    lines: ['The text under the picture'],
  },
  long: {
    title: 'COSPLAYS',
    items: ['First cosplay', 'Second cosplay', 'Third cosplay'],
  },
},
    { slug: 'the-outlast-trials', name: 'The Outlast Trials', theme: 'outlast-trials',
      gifs: [
        '/robbie-the-rabbit.gif',
 ],
       top: {
    title: 'QUICK FACTS',
    image: '/halo.png',
    alt: 'A short description of the picture',
    lines: ['The text under the picture'],
  },
  long: {
    title: 'COSPLAYS',
    items: ['First cosplay', 'Second cosplay', 'Third cosplay'],
  },
},
  ];
  return fandoms.map((fandom) => ({
    params: { slug: fandom.slug },
    props: { fandom },
  }));
}

const { fandom } = Astro.props;
const top = fandom.top ?? { title: 'INFO', lines: ['Coming soon...'] };
const long = fandom.long ?? { title: 'MORE', lines: ['Coming soon...'] };
---
<SiteLayout
  title={fandom.name}
  description={`Cosplays, art, and collections inspired by ${fandom.name}.`}
  theme={fandom.theme}
  headerTitle={fandom.name}
  marqueeImages={fandom.gifs}
>
  <div class="win98-window">
    <div class="win98-title">📁 {fandom.name.toUpperCase()}</div>
    <div class="win98-content">
      <h3>{fandom.name}</h3>
      <p>Cosplays, art, and collections inspired by {fandom.name}.</p>
    </div>
  </div>

  <div class="win98-window">
    <div class="win98-title">🗂️ POSTS</div>
    <div class="win98-content">
      <p>Nothing here yet... check back soon.</p>
    </div>
  </div>
  <div slot="right" class="win98-window panel-top">
    <div class="win98-title">{top.title}</div>
    <div class="win98-content">
      {top.image && (
        <div class="panel-photo-box">
          <img class="panel-photo" src={top.image} alt={top.alt ?? ''} onerror="this.style.display='none'" />
        </div>
      )}
      {top.lines?.map((line) => <p class="panel-caption">{line}</p>)}
    </div>
  </div>
  <div slot="right" class="win98-window">
    <div class="win98-title">{long.title}</div>
    <div class="win98-content">
      {long.lines?.map((line) => <p>{line}</p>)}
      {long.sections?.map((section) => (
        <div class="panel-section">
          <h3>{section.heading}</h3>
          {section.items.length > 0 ? (
            <ul class="panel-list">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p class="panel-empty">none yet</p>
          )}
        </div>
      ))}
      {long.items && (
        <ul class="panel-list">
          {long.items.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</SiteLayout>

<style>
  .win98-content h3 {
    margin-top: 0;
    color: var(--logo);
  }

  /* Top square panel: the picture fills the space, the caption sits underneath */
  .panel-top .win98-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
  }
  .panel-photo-box {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .panel-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .panel-caption {
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
  }

  /* Bottom panel: the list, with dashed lines between items */
  .panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel-list li {
    padding: 6px 0;
    border-bottom: 1px dashed var(--divider, #0a3a14);
  }
  .panel-list li:last-child {
    border-bottom: none;
  }
</style>
