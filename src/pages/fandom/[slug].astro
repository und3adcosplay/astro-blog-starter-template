const { fandom } = Astro.props;
const top = fandom.top ?? { title: 'INFO', lines: ['Coming soon...'] };
const long = fandom.long ?? { title: 'MORE', lines: ['Coming soon...'] };
---
<SiteLayout
  title={fandom.name}
  description={`Cosplays, art, and collections inspired by ${fandom.name}.`}
  theme={fandom.theme}
  headerTitle={fandom.name}
  marqueeImages={fandom.gifs}
>
  <div class="win98-window">
    <div class="win98-title">📁 {fandom.name.toUpperCase()}</div>
    <div class="win98-content">
      <h3>{fandom.name}</h3>
      <p>Cosplays, art, and collections inspired by {fandom.name}.</p>
    </div>
  </div>

  <div class="win98-window">
    <div class="win98-title">🗂️ POSTS</div>
    <div class="win98-content">
      <p>Nothing here yet... check back soon.</p>
    </div>
  </div>

  <div slot="right" class="win98-window panel-top">
    <div class="win98-title">{top.title}</div>
    <div class="win98-content">
      {top.links && (
        <div class="panel-links">
          {top.links.map((link) => (
            <a
              class="panel-link"
              href={link.href}
              target={link.href?.startsWith('http') ? '_blank' : undefined}
              rel={link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <div class="panel-link-img">
                <img src={link.image} alt={link.alt ?? ''} onerror="this.style.display='none'" />
              </div>
              <span class="panel-link-title">{link.title}</span>
            </a>
          ))}
        </div>
      )}
      {top.image && (
        <div class="panel-photo-box">
          <img class="panel-photo" src={top.image} alt={top.alt ?? ''} onerror="this.style.display='none'" />
        </div>
      )}
      {top.lines?.map((line) => <p class="panel-caption">{line}</p>)}
    </div>
  </div>

  <div slot="right" class="win98-window">
    <div class="win98-title">{long.title}</div>
    <div class="win98-content">
      {long.lines?.map((line) => <p>{line}</p>)}
      {long.sections?.map((section) => (
        <div class="panel-section">
          <h3>{section.heading}</h3>
          {section.items.filter(Boolean).length > 0 ? (
            <ul class="panel-list">
              {section.items.filter(Boolean).map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p class="panel-empty">None</p>
          )}
        </div>
      ))}
      {long.items && (
        <ul class="panel-list">
          {long.items.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</SiteLayout>

<style>
  .win98-content h3 {
    margin-top: 0;
    color: var(--logo);
  }

  /* Top square panel: the picture fills the space, the caption sits underneath */
  .panel-top .win98-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
  }
  .panel-photo-box {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  .panel-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .panel-caption {
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
  }

  /* Top square panel: a 2 x 2 grid of linked pictures with titles underneath */
  .panel-links {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .panel-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    min-height: 0;
    color: var(--link, #33ff77);
    text-decoration: none;
  }
  .panel-link:hover {
    color: var(--hover-text, #ffffff);
  }
  .panel-link-img {
    position: relative;
    flex: 1;
    min-height: 0;
    background: rgba(0, 0, 0, 0.25);
  }
  .panel-link:hover .panel-link-img {
    outline: 1px solid var(--logo);
  }
  .panel-link-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .panel-link-title {
    font-size: 0.7rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Bottom panel: the sections and lists, with dashed lines between items */
  .panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel-list li {
    padding: 6px 0;
    border-bottom: 1px dashed var(--divider, #0a3a14);
  }
  .panel-list li:last-child {
    border-bottom: none;
  }
  .panel-section + .panel-section {
    margin-top: 18px;
  }
  .panel-section h3 {
    margin: 0 0 6px 0;
  }
  .panel-empty {
    margin: 0;
    font-style: italic;
    opacity: 0.7;
  }
</style>
