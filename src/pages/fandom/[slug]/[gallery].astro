---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { galleryFandoms } from '../../../data/galleries.js';

// Builds one page for every gallery listed in src/data/galleries.js,
// for example /fandom/silent-hill/art. You don't need to change anything in this file.
export function getStaticPaths() {
  const paths = [];
  for (const [slug, fandom] of Object.entries(galleryFandoms)) {
    for (const key of Object.keys(fandom.galleries)) {
      paths.push({ params: { slug, gallery: key }, props: { slug, fandom, galleryKey: key } });
    }
  }
  return paths;
}

const { slug, fandom, galleryKey } = Astro.props;
const gallery = fandom.galleries[galleryKey];

// A gallery with  layout: 'grid'  in the data file is shown as ONE big panel with
// every photo in it and a title under each photo. Any other gallery gets one panel per item.
const isGrid = gallery.layout === 'grid';

// For the one-big-panel layout: every item is one photo with a title under it
const gridPhotos = (gallery.items ?? [])
  .map((item) => ({
    image: item.image ?? item.photos?.[0]?.image,
    title: item.title ?? '',
    href: item.href ?? item.photos?.[0]?.href,
    alt: item.alt,
  }))
  .filter((photo) => photo.image);

// For the one-panel-per-item layout: each item can have a list of "photos",
// or just a single "image" (older items with one image still work).
const panels = (gallery.items ?? []).map((item) => ({
  title: item.title ?? '',
  photos: item.photos ?? (item.image ? [{ image: item.image, href: item.href }] : []),
}));

// Pictures and other websites open in a new tab, pages on this site open normally
const opensInNewTab = (href) => href.startsWith('http') || /\.(png|jpe?g|gif|webp)$/i.test(href);
---
<SiteLayout
  title={`${fandom.name}: ${gallery.title}`}
  description={`${gallery.title} inspired by ${fandom.name}.`}
  theme={fandom.theme}
  headerTitle={fandom.name}
  marqueeImages={fandom.gifs?.length ? fandom.gifs : undefined}
  scrollCenter
>
  <div class="win98-window">
    <div class="win98-title">📁 {fandom.name.toUpperCase()} / {gallery.title.toUpperCase()}</div>
    <div class="win98-content">
      <a class="back-button" href={`/fandom/${slug}`}>⬅ BACK</a>
    </div>
  </div>

  {isGrid ? (
    <div class="win98-window">
      <div class="win98-title">🖼️ {gallery.title.toUpperCase()}</div>
      <div class="win98-content photo-row">
        {gridPhotos.length > 0 ? (
          gridPhotos.map((photo) => {
            const href = photo.href ?? photo.image;
            return (
              <a
                class="grid-item"
                href={href}
                target={opensInNewTab(href) ? '_blank' : undefined}
                rel={opensInNewTab(href) ? 'noopener noreferrer' : undefined}
              >
                <span class="photo">
                  <img
                    src={photo.image}
                    alt={photo.alt ?? photo.title}
                    onerror="this.style.display='none'"
                  />
                </span>
                {photo.title && <span class="grid-title">{photo.title}</span>}
              </a>
            );
          })
        ) : (
          <p class="no-photos">Nothing here yet... check back soon.</p>
        )}
      </div>
    </div>
  ) : panels.length > 0 ? (
    panels.map((panel) => (
      <div class="win98-window">
        <div class="win98-title">🖼️ {(panel.title || gallery.title).toUpperCase()}</div>
        <div class="win98-content photo-row">
          {panel.photos.length > 0 ? (
            panel.photos.map((photo) => {
              const href = photo.href ?? photo.image;
              return (
                <a
                  class="photo"
                  href={href}
                  target={opensInNewTab(href) ? '_blank' : undefined}
                  rel={opensInNewTab(href) ? 'noopener noreferrer' : undefined}
                >
                  <img
                    src={photo.image}
                    alt={photo.alt ?? panel.title}
                    onerror="this.style.display='none'"
                  />
                </a>
              );
            })
          ) : (
            <p class="no-photos">No photos here yet...</p>
          )}
        </div>
      </div>
    ))
  ) : (
    <div class="win98-window">
      <div class="win98-title">🖼️ {gallery.title.toUpperCase()}</div>
      <div class="win98-content">
        <p>Nothing here yet... check back soon.</p>
      </div>
    </div>
  )}
</SiteLayout>

<style is:global>
  /* The gallery pages have no right-side panels, so the middle column stretches across */
  #rightSidebar {
    display: none !important;
  }
  /* Keep the left menu at its normal width */
  @media (min-width: 851px) {
    #leftSidebar {
      flex: 0 0 196px !important;
    }
  }
  /* How big each photo is. Change this one number to make every photo bigger or smaller. */
  #centerContent {
    --photo-size: 150px;
  }
</style>

<style>
  /* The back button */
  .back-button {
    display: inline-block;
    padding: 5px 14px;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    color: var(--link);
    background: var(--panel);
    border: 1px solid var(--border);
    box-shadow: 2px 2px 0 #000000;
  }
  .back-button:hover {
    background: var(--bar);
    color: var(--bar-text);
  }

  /* The photos sit in a row, and when they run out of room they wrap onto a new row.
     The panel grows taller on its own to fit them. */
  .photo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .photo {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: var(--photo-size, 150px);
    height: var(--photo-size, 150px);
    background: #000000;
    border: 1px solid var(--border);
  }
  .photo:hover {
    border-color: var(--logo);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .no-photos {
    margin: 0;
  }

  /* A photo with its title underneath (Art and Merch) */
  .grid-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: var(--photo-size, 150px);
    color: var(--link);
    text-decoration: none;
  }
  .grid-item:hover {
    color: var(--hover-text);
  }
  .grid-item:hover .photo {
    border-color: var(--logo);
  }
  .grid-title {
    font-size: 0.8rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* On phones, show two photos per row */
  @media (max-width: 600px) {
    .photo {
      width: calc(50% - 7px);
      height: auto;
      aspect-ratio: 1 / 1;
    }
    .grid-item {
      width: calc(50% - 7px);
    }
    .grid-item .photo {
      width: 100%;
    }
  }
</style>
