---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { galleryFandoms } from '../../../data/galleries.js';

// Builds one page for every gallery listed in src/data/galleries.js,
// for example /fandom/silent-hill/art. You don't need to change anything in this file.
export function getStaticPaths() {
  const paths = [];
  for (const [slug, fandom] of Object.entries(galleryFandoms)) {
    for (const key of Object.keys(fandom.galleries)) {
      paths.push({ params: { slug, gallery: key }, props: { slug, fandom, galleryKey: key } });
    }
  }
  return paths;
}

const { slug, fandom, galleryKey } = Astro.props;
const gallery = fandom.galleries[galleryKey];
const items = gallery.items ?? [];

// Pictures and other websites open in a new tab, pages on this site open normally
const opensInNewTab = (href) => href.startsWith('http') || /\.(png|jpe?g|gif|webp)$/i.test(href);
---
<SiteLayout
  title={`${fandom.name}: ${gallery.title}`}
  description={`${gallery.title} inspired by ${fandom.name}.`}
  theme={fandom.theme}
  headerTitle={fandom.name}
  marqueeImages={fandom.gifs?.length ? fandom.gifs : undefined}
>
  <div class="win98-window gallery-top">
    <div class="win98-title">📁 {fandom.name.toUpperCase()} / {gallery.title.toUpperCase()}</div>
    <div class="win98-content">
      <h3>{gallery.title}</h3>
      {gallery.intro && <p>{gallery.intro}</p>}
      <a class="back-button" href={`/fandom/${slug}`}>← {fandom.name}</a>
    </div>
  </div>

  {items.length > 0 ? (
    items.map((item, index) => {
      const href = item.href ?? item.image;
      return (
        <div class="win98-window item-card">
          <div class="win98-title">🖼️ {gallery.title.toUpperCase()} #{index + 1}</div>
          <div class="win98-content item-body">
            <a
              class="item-photo"
              href={href}
              target={opensInNewTab(href) ? '_blank' : undefined}
              rel={opensInNewTab(href) ? 'noopener noreferrer' : undefined}
            >
              <img src={item.image} alt={item.title} onerror="this.style.display='none'" />
            </a>
            <div class="item-info">
              <h3>{item.title}</h3>
              {item.description && <p>{item.description}</p>}
              {item.href && (
                <a
                  class="back-button"
                  href={item.href}
                  target={opensInNewTab(item.href) ? '_blank' : undefined}
                  rel={opensInNewTab(item.href) ? 'noopener noreferrer' : undefined}
                >
                  {item.linkLabel ?? 'VIEW'}
                </a>
              )}
            </div>
          </div>
        </div>
      );
    })
  ) : (
    <div class="win98-window gallery-top">
      <div class="win98-title">🖼️ {gallery.title.toUpperCase()}</div>
      <div class="win98-content">
        <p>Nothing here yet... check back soon.</p>
      </div>
    </div>
  )}
</SiteLayout>

<style is:global>
  /* The gallery pages have no right-side panels, so the middle column stretches across */
  #rightSidebar {
    display: none !important;
  }
  /* Keep the left menu at its normal width */
  @media (min-width: 851px) {
    #leftSidebar {
      flex: 0 0 196px !important;
    }
  }
  /* The height of every panel on these pages. Change this one number to resize them all.
     The picture is always the panel's height minus the title bar and padding. */
  #centerContent {
    --card-height: 180px;
    --photo-size: calc(var(--card-height) - 54px);
  }
</style>

<style>
  .win98-content h3 {
    margin: 0 0 6px 0;
    color: var(--logo);
  }

  /* The top panel and every picture panel are exactly the same size */
  .gallery-top,
  .item-card {
    display: flex;
    flex-direction: column;
    height: var(--card-height, 180px);
    overflow: hidden;
  }
  .gallery-top .win98-content,
  .item-card .win98-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .gallery-top p {
    margin: 0 0 12px 0;
  }

  /* Picture on the left, words on the right */
  .item-body {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .item-photo {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: var(--photo-size, 126px);
    height: var(--photo-size, 126px);
    background: #000000;
    border: 1px solid var(--border);
  }
  .item-photo:hover {
    border-color: var(--logo);
  }
  .item-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .item-info {
    flex: 1;
    min-width: 0;
  }
  .item-info p {
    margin: 0 0 10px 0;
  }

  /* The back button, and the optional link button on a picture panel */
  .back-button {
    display: inline-block;
    padding: 5px 14px;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    color: var(--link);
    background: var(--panel);
    border: 1px solid var(--border);
    box-shadow: 2px 2px 0 #000000;
  }
  .back-button:hover {
    background: var(--bar);
    color: var(--bar-text);
  }

  /* On phones, let each panel grow to fit its words */
  @media (max-width: 600px) {
    .gallery-top,
    .item-card {
      height: auto;
    }
    .item-photo {
      width: 110px;
      height: 110px;
    }
  }
</style>
