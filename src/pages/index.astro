---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="UND3AD._COSPLAY">
  <!-- WELCOME / INTRO WINDOW -->
  <div class="win98-window">
    <div class="win98-title">You got 1 new message!</div>
    <div class="win98-content">
      <h3> Welcome, foolish mortals...</h3>
      <p>Hey, welcome to my website! I’m UND3AD, a cosplayer, collector, and artist! Here you will find not just cosplay related things but drawings, cross-stitch, paintings, SFX-makeup, blog posts, topic discussions, + more. I love writing and expressing myself and this is my own little place where I do all of that. If you have any questions, contact me on Instagram: @und3ad._cosplay</p>
      <p>Thank you for stopping by! ♡</p>
    </div>
  </div>
</SiteLayout>
