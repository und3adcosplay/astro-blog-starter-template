---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="About Me"
  description="About UND3AD._COSPLAY: cosplayer, artist, and horror enthusiast."
>
  <!-- TOP ROW: photo on the left, basic info on the right (both squares) -->
  <div class="top-row">
    <div class="win98-window square">
      <div class="win98-title">ME.JPG</div>
      <div class="photo-frame">
        <div class="photo-placeholder">your photo goes here</div>
        <!-- Shows automatically once a file named me.jpg is in the "public" folder -->
        <img src="/me.jpg" alt="A photo of me" onerror="this.style.display='none'" />
      </div>
    </div>

    <div class="win98-window square">
      <div class="win98-title">BASIC INFO</div>
      <div class="win98-content">
        <dl class="info-list">
          <div>
            <dt>Name</dt>
            <dd>UND3AD</dd>
          </div>
          <div>
            <dt>Species</dt>
            <dd>Vampire</dd>
          </div>
          <div>
            <dt>Gender</dt>
            <dd>♀</dd>
          </div>
          <div>
            <dt>Age</dt>
            <dd>240</dd>
          </div>
          <div>
            <dt>Birthday</dt>
            <dd>June 28th</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- MAIN PROFILE WINDOW -->
  <div class="win98-window">
    <div class="win98-title">PROFILE.EXE</div>
    <div class="win98-content">
      <h3>Who is UND3AD._COSPLAY?</h3>
      <p>Hey there! Welcome to my profile page. I am a cosplayer, artist, and massive horror enthusiast.</p>
      <p>Here you will find updates on my sewing projects, upcoming spooky conventions, and cross-stitch patterns I am designing.</p>

      <h4>Current Obsessions:</h4>
      <ul>
        <li>90s Horror Aesthetics</li>
        <li>Retro PlayStation Survival Horror Games</li>
        <li>Vampire lore & makeup special effects</li>
      </ul>
    </div>
  </div>

  <!-- RIGHT SIDEBAR: one long FAVORITES panel (replaces the default Site Status + Cosplans on this page) -->
  <div slot="right" class="win98-window favorites">
    <div class="win98-title">HOBBIES</div>
    <div class="win98-content">
      <dl class="info-list">
        <div>
          <dt>🎭Cosplay🎭</dt>
        </div>
        <div>
          <dt>🎨Art🎨</dt>
        </div>
        <div>
          <dt>🎹Music🎹</dt>
        </div>
        <div>
          <dt>🎥Watching Movies🎥</dt>
        </div>
        <div>
          <dt>🎮Gaming🎮</dt>
        </div>
        <div>
          <dt>🧩Collecting🧩</dt>
        </div>
        <div>
          <dt>🪡Cross-stitching🪡</dt>
        </div>
        <div>
          <dt>📝Writing📝</dt>
        </div>
        <div>
          <dt>⚰️Napping⚰️</dt>
        </div>
      </dl>
    </div>
  </div>
</SiteLayout>

<style>
  /* ---------- Photo + basic info row ---------- */
  .top-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
  }
  .square,
  .favorites {
    display: flex;
    flex-direction: column;
  }
  .square {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 0;
  }
  /* The favorites panel grows to fill the full height of the page */
  .favorites {
    flex: 1;
  }
  .square .win98-content,
  .favorites .win98-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .photo-frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background-color: #000000;
  }
  .photo-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    text-align: center;
    font-size: 0.85rem;
    color: #444444;
  }
  .photo-frame img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---------- Info lists: rows spread out evenly with a dashed divider between them ---------- */
  .info-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .info-list div {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px dashed #0a3a14;
  }
  .info-list div:last-child {
    border-bottom: none;
  }
  .info-list dt {
    color: #00ff66;
    font-size: 0.75rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .info-list dd {
    margin: 0;
  }
  @media (max-width: 600px) {
    .top-row {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Text styles for the profile window ---------- */
  .win98-content h3 {
    margin-top: 0;
    color: #00ff66;
  }
  .win98-content h4 {
    color: #00ff66;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .win98-content ul {
    padding-left: 20px;
    margin: 5px 0;
  }
  .win98-content li {
    margin-bottom: 5px;
  }
</style>
