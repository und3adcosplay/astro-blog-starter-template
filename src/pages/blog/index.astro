---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

// This automatically collects all your markdown blog posts, newest first
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<SiteLayout title="Blog" description="All of my blog entries">
	<div class="win98-window">
		<div class="win98-title">📝 ARCHIVE</div>
		<div class="win98-content">
			<h1 class="page-title">Blog Entries</h1>
			<hr />
			{posts.length === 0 && <p>no entries yet... check back soon.</p>}
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="entry-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</SiteLayout>

<style>
	.page-title {
		font-family: 'Creepster', 'Impact', sans-serif;
		font-size: 2.2rem;
		font-weight: normal;
		letter-spacing: 2px;
		color: #00ff66;
		text-shadow: 0 0 4px #00ff66, 0 0 10px #00ff66;
		margin: 0 0 10px 0;
	}
	hr {
		border: none;
		border-top: 2px dashed #0d4a1b;
		margin: 12px 0 18px 0;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		background-color: #031206;
		border: 1px solid #0d4a1b;
		border-left: 4px solid #0d4a1b;
		padding: 10px 14px;
		margin-bottom: 10px;
		transition: border-left-color 0.2s;
	}
	.post-list li:hover {
		border-left-color: #a00000;
	}
	.post-list a {
		color: #33ff77;
		font-weight: bold;
		font-size: 1.1rem;
		text-decoration: none;
	}
	.post-list a:hover {
		color: #ffffff;
	}
	.entry-date {
		font-size: 0.8rem;
		color: #8a8a8a;
	}
</style>
