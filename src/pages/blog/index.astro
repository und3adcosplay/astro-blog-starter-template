---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

// This automatically collects all your markdown blog posts!
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>My Blog Entries</title>
    </head>
    <body>
        <div id="container">
            <div id="headerArea">
                <div id="header"></div>
                <nav id="navbar">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog">Blog</a></li>
                    </ul>
                </nav>
            </div>

            <div id="flex">
                <aside id="leftSidebar">
                    <h2>Navigation</h2>
                    <div class="box">
                        <p>Welcome to the archives!</p>
                    </div>
                </aside>

                <main>
                    <h1>Blog Entries</h1>
                    <hr />
                    <ul class="post-list">
                        {
                            posts.map((post) => (
                                <li>
                                    <a href={`/blog/${post.id}/`}>
                                        {post.data.heroImage && (
                                            <img class="entry-img" src={post.data.heroImage} alt="" />
                                        )}
                                        <h2 class="entry-title">{post.data.title}</h2>
                                    </a>
                                    <p class="entry-date">
                                        <FormattedDate date={post.data.pubDate} />
                                    </p>
                                </li>
                            ))
                        }
                    </ul>
                </main>

                <aside id="rightSidebar">
                    <h2>Updates</h2>
                    <ul>
                        <li>Browsing archive list!</li>
                    </ul>
                </aside>
            </div>
            <footer id="footer">CC0 Public Domain, 2026</footer>
        </div>
    </body>
</html>

<style>
    :root {
        --header-image: url('https://neocities.org');
        --body-bg-image: url('https://neocities.org');
    }

    @font-face {
        font-family: Nunito;
        src: url('https://neocities.org');
    }

    body {
        font-family: 'Nunito', sans-serif;
        margin: 0;
        background-color: #08031A;
        background-size: 65px;
        color: #fceaff;
        background-image: var(--body-bg-image);
    }

    * {
        box-sizing: border-box;
    }

    #container {
        max-width: 900px;
        margin: 0 auto;
    }

    #container a {
        color: #ED64F5;
        text-decoration: none;
    }

    #header {
        width: 100%;
        background-color: #5e4e8c;
        height: 150px;
        background-image: var(--header-image);
        background-size: 100%;
    }

    #navbar {
        height: 40px;
        background-color: #13092D;
        width: 100%;
    }

    #navbar ul {
        display: flex;
        padding: 0;
        margin: 0;
        list-style-type: none;
        justify-content: space-evenly;
    }

    #navbar li {
        padding-top: 10px;
    }

    #navbar li a {
        color: #ED64F5;
        font-weight: 800;
    }

    #flex {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    main {
        flex: 2;
        background: rgba(19, 9, 45, 0.7);
        padding: 20px;
        border-radius: 8px;
    }

    #leftSidebar, #rightSidebar {
        flex: 1;
        background: rgba(94, 78, 140, 0.2);
        padding: 15px;
        border-radius: 8px;
    }

    .post-list {
        list-style-type: none;
        padding: 0;
    }

    .post-list li {
        margin-bottom: 30px;
        background: rgba(0, 0, 0, 0.2);
        padding: 15px;
        border-radius: 6px;
    }

    .entry-img {
        width: 100%;
        max-height: 250px;
        object-fit: cover;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .entry-title {
        margin: 5px 0;
        color: #ED64F5;
    }

    .entry-date {
        font-size: 0.85em;
        color: #fceaff;
        margin: 0;
    }

    .box {
        background: rgba(0, 0, 0, 0.2);
        padding: 10px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    #footer {
        text-align: center;
        margin-top: 20px;
        padding: 10px;
        font-size: 0.8em;
    }

    @media (max-width: 768px) {
        #flex {
            flex-direction: column;
        }
    }
</style>

		</main>
		<Footer />
	</body>
</html>
