---
import SiteLayout from './SiteLayout.astro';

const { title, description } = Astro.props;
---
<SiteLayout title={title} description={description}>
  <article class="win98-window">
    <div class="win98-title">📝 BLOG ENTRY</div>
    <div class="win98-content post-content">
      <h1>{title}</h1>
      <hr />
      <slot />
    </div>
  </article>
</SiteLayout>

<style is:global>
  /* Look of everything inside a blog post (headings, links, images, quotes, code) */
  .post-content h1 {
    font-family: 'Creepster', 'Impact', sans-serif;
    font-size: 2.2rem;
    font-weight: normal;
    letter-spacing: 2px;
    color: #00ff66;
    text-shadow: 0 0 4px #00ff66, 0 0 10px #00ff66;
    margin: 0 0 10px 0;
  }
  .post-content h2,
  .post-content h3 {
    color: #33ff77;
    margin: 1.2em 0 0.4em 0;
  }
  .post-content p {
    margin: 0 0 1em 0;
  }
  .post-content a {
    color: #33ff77;
  }
  .post-content a:hover {
    color: #ffffff;
  }
  .post-content img {
    max-width: 100%;
    height: auto;
    border: 2px solid #125a22;
  }
  .post-content blockquote {
    border-left: 4px solid #a00000;
    margin: 1em 0;
    padding-left: 14px;
    color: #b8ccbc;
  }
  .post-content code {
    background-color: #031a07;
    color: #88ffaa;
    padding: 2px 5px;
  }
  .post-content pre {
    background-color: #031a07;
    border: 1px solid #0d4a1b;
    padding: 12px;
    overflow-x: auto;
  }
  .post-content pre code {
    background: none;
    padding: 0;
  }
  .post-content hr {
    border: none;
    border-top: 2px dashed #0d4a1b;
    margin: 12px 0;
  }
</style>
