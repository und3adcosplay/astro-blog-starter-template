---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <BaseHead title={title} />

    <style>
      /* ---------- Page basics ---------- */
      * {
        box-sizing: border-box;
      }
      body {
        font-family: 'Nunito', sans-serif;
        margin: 0;
        background-color: #08031A;
        color: #fceaff;
      }
      #container {
        max-width: 900px;
        margin: 0 auto;
      }
      #container a {
        color: #ED64F5;
        font-weight: bold;
      }

      /* ---------- Header & top nav ---------- */
      #header {
        width: 100%;
        height: 150px;
        background-color: #5e4e8c;
      }
      #navbar {
        height: 40px;
        background-color: #13092D;
        width: 100%;
      }
      #navbar ul {
        display: flex;
        padding: 0;
        margin: 0;
        list-style-type: none;
        justify-content: space-evenly;
      }
      #navbar li {
        padding-top: 10px;
      }
      #navbar li a {
        color: #ED64F5;
        font-weight: 800;
        text-decoration: none;
      }

      /* ---------- Main content & sidebar ---------- */
      #flex {
        display: flex;
        gap: 20px;
        margin-top: 20px;
      }
      main {
        flex: 3;
        background: #000000;
        padding: 20px;
        border-radius: 8px;
      }
      #leftSidebar {
        flex: 1;
        background: #000000;
        padding: 15px;
        border-radius: 8px;
      }
      .box {
        background: #000000;
        padding: 10px;
        border-radius: 4px;
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    <div id="container">
      <div id="header"></div>
      <div id="headerArea">
        <nav id="navbar">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/blog">Blog</a></li>
          </ul>
        </nav>
      </div>

      <div id="flex">
        <main>
          <article>
            <h1>{title}</h1>
            <hr />
            <slot /> <!-- your content is injected here -->
          </article>
        </main>

        <aside id="leftSidebar">
          <h2>Navigation</h2>
          <div class="box">
            <p>Welcome to my blog space!</p>
          </div>
          <h2>Updates</h2>
          <ul>
            <li>Site launched on Cloudflare Workers!</li>
          </ul>
        </aside>
      </div>

     <Footer />
    </div>
  </body>
</html>
